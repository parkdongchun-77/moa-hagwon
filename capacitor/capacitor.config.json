{
  "appId": "kr.moahagwon.app",
  "appName": "모아학원",
  "webDir": "www",
  "backgroundColor": "#ffffffff",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#4f46e5ff",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "ios": {
    "contentInset": "always"
  },
  "android": {
    "allowMixedContent": false
  }
}
